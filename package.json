{
  "name": "kaiyolab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env ./node_modules/astro/bin/astro.mjs dev --host 127.0.0.1 --ignore-lock",
    "build": "astro build",
    "preview": "node scripts/start.mjs",
    "check": "astro check",
    "test": "vitest run --exclude tests/integration/**",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:migrate": "node scripts/migrate.mjs",
    "account:recover": "node scripts/recover.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/node": "11.1.6",
    "@astrojs/react": "6.0.6",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/view": "^6.43.12",
    "@fontsource-variable/noto-sans-tc": "^5.2.0",
    "@fontsource-variable/space-grotesk": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tailwindcss/vite": "^4.1.0",
    "@uiw/react-codemirror": "^4.25.0",
    "astro": "7.3.3",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-pretty-code": "^0.14.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.4",
    "shiki": "^3.0.0",
    "tailwindcss": "^4.1.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  }
}
