---
import Ui from './UiText.astro';
import Icon from './Icon.astro';
import { uiLabel, uiPlaceholder, uiText, type UiKey } from '../../lib/ui-language';
import type { ListConfig } from '../../lib/listing';
import '../../styles/public-collection.css';
interface Props {
  config: ListConfig;
  sort: string;
  q: string;
  searchLabel?: UiKey;
  searchId?: string;
  anchor?: string;
  help?: boolean;
}
const {
  config,
  sort,
  q,
  searchLabel = 'Search articles',
  searchId = 'article-search',
  anchor = '',
  help = false,
} = Astro.props;
const labels: Record<string, UiKey> = {
  manual: 'Default order',
  newest: 'Newest first',
  oldest: 'Oldest first',
  'title-asc': 'Title A–Z',
  'title-desc': 'Title Z–A',
};
---

<form
  class="collection-controls"
  method="get"
  action={`${Astro.url.pathname}${anchor ? `#${anchor}` : ''}`}
  role="search"
  {...uiLabel(searchLabel)}
>
  <div class="collection-search">
    <label class="sr-only" for={searchId}>
      <Ui text={searchLabel} />
    </label>
    <Icon name="search" size={19} />
    <input
      id={searchId}
      type="search"
      name="q"
      value={q}
      maxlength="200"
      {...uiPlaceholder('Search titles or content…')}
      autocomplete="off"
    />
  </div>
  {['category', 'tag'].map(
    (name) =>
      Astro.url.searchParams.get(name) && (
        <input type="hidden" name={name} value={Astro.url.searchParams.get(name)!} />
      ),
  )}
  <label class="collection-sort" for="collection-sort">
    <Ui text="Sort" />
    <select id="collection-sort" name="sort" {...uiLabel('Sort by')}>
      {config.sorts.map((value) => (
        <option
          value={value}
          selected={sort === value}
          data-ui-option-en={uiText(labels[value])}
          data-ui-option-zh={uiText(labels[value], 'zh-TW')}
        >
          {uiText(labels[value])}
        </option>
      ))}
    </select>
  </label>
  <button id={`${searchId}-submit`} type="submit">
    <Ui text="Search" />
  </button>
</form>
{help && (
  <details class="collection-search-help" id={`${searchId}-help`}>
    <summary id={`${searchId}-help-toggle`}>
      <Ui text="Search help" />
    </summary>
    <p>
      <Ui text="Separate keywords with spaces, or use quotes for an exact phrase" />
    </p>
  </details>
)}
<script>
  import { initializePublicCollections } from '../../scripts/public-collections';
  initializePublicCollections();
</script>
