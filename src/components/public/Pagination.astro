---
import Icon from './Icon.astro';
interface Props {
  page: number;
  pages: number;
}
const { page, pages } = Astro.props;
const pageLink = (n: number) => {
  const url = new URL(Astro.url);
  url.searchParams.set('page', String(n));
  return `${url.pathname}${url.search}`;
};
const visible = Array.from({ length: pages }, (_, i) => i + 1).filter(
  (n) => n === 1 || n === pages || Math.abs(n - page) < 2,
);
---

{pages > 1 && (
  <nav class="pagination" aria-label="內容分頁">
    {page > 1 ? (
      <a class="pagination-direction" href={pageLink(page - 1)} aria-label="上一頁">
        <Icon name="back" size={17} />
      </a>
    ) : (
      <span class="pagination-direction disabled">
        <Icon name="back" size={17} />
      </span>
    )}
    {visible.map((n, i) => (
      <>
        {i > 0 && n - visible[i - 1] > 1 && <span class="pagination-gap">…</span>}
        <a
          href={pageLink(n)}
          class:list={{ selected: n === page }}
          aria-current={n === page ? 'page' : undefined}
        >
          {n}
        </a>
      </>
    ))}
    {page < pages ? (
      <a class="pagination-direction" href={pageLink(page + 1)} aria-label="下一頁">
        <Icon size={17} />
      </a>
    ) : (
      <span class="pagination-direction disabled">
        <Icon size={17} />
      </span>
    )}
  </nav>
)}
