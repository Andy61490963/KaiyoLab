---
import Icon from './Icon.astro';
interface Props {
  code: '404' | '500';
  title: string;
  description: string;
}
const { code, title, description } = Astro.props;
---

<section class="page-shell error-page" aria-labelledby="error-title">
  <div class="error-map" aria-hidden="true">
    <span class="map-orbit map-orbit-one"></span>
    <span class="map-orbit map-orbit-two"></span>
    <span class="map-center">{code}</span>
    <span class="map-point"></span>
    <span class="map-caption">
      {code === '404' ? 'UNEXPLORED TERRITORY' : 'SIGNAL INTERRUPTED'}
    </span>
  </div>
  <span class="eyebrow">{code === '404' ? '似乎走進了未知的座標' : '觀測站的訊號暫時中斷'}</span>
  <h1 id="error-title">{title}</h1>
  <p>{description}</p>
  <div class="error-actions">
    <a class="button button-primary" href="/">
      回到首頁 <Icon name="arrow" size={17} />
    </a>
    <a class="text-link" href="/articles">
      探索文章 <Icon name="diagonal" size={17} />
    </a>
  </div>
</section>
<style>
  .error-page {
    padding-block: 64px 95px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    min-height: 640px;
  }
  .error-map {
    width: 275px;
    height: 218px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 28px;
  }
  .map-orbit {
    position: absolute;
    border: 1px solid var(--border);
    border-radius: 50%;
  }
  .map-orbit-one {
    width: 188px;
    height: 188px;
  }
  .map-orbit-two {
    width: 268px;
    height: 105px;
    transform: rotate(-24deg);
    border-color: var(--accent);
    opacity: 0.28;
  }
  .map-center {
    font-family: var(--font-display);
    font-size: 66px;
    font-weight: 500;
    letter-spacing: -5px;
    color: var(--text);
  }
  .map-point {
    width: 9px;
    height: 9px;
    background: var(--accent);
    border-radius: 50%;
    position: absolute;
    top: 53px;
    right: 42px;
    box-shadow: 0 0 0 6px var(--bg);
  }
  .map-caption {
    position: absolute;
    bottom: -2px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 2px;
  }
  .error-page > .eyebrow {
    color: var(--accent);
    letter-spacing: 1px;
    font-size: 10px;
  }
  h1 {
    margin-block: 17px 12px;
    font-weight: 600;
    letter-spacing: -1px;
    font-size: 30px;
    line-height: 1.5;
  }
  p {
    color: var(--muted);
    max-width: 390px;
    font-size: 12px;
    line-height: 2;
  }
  .error-actions {
    display: flex;
    align-items: center;
    gap: 25px;
    margin-top: 28px;
  }
  @media (max-width: 700px) {
    .error-page {
      padding-block: 37px 65px;
      min-height: 580px;
    }
    h1 {
      font-size: 25px;
    }
    .error-map {
      margin-bottom: 24px;
    }
  }
</style>
