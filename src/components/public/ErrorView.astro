---
import UiText from './UiText.astro';
import Icon from './Icon.astro';
interface Props {
  code: '404' | '500';
  title: string;
  description: string;
}
const { code, title, description } = Astro.props;
---

<section class="page-shell error-page" aria-labelledby="error-title">
  <span class="error-code" aria-hidden="true">
    {code}
  </span>
  <h1 id="error-title">
    <UiText en={title} zh={code === '404' ? '找不到頁面' : '暫時無法使用'} />
  </h1>
  <p>
    <UiText
      en={description}
      zh={
        code === '404'
          ? '請檢查網址，或回到首頁瀏覽文章與專案。'
          : '請稍後重新整理頁面；若問題持續發生，請聯絡站長。'
      }
    />
  </p>
  <div class="error-actions">
    <a class="button button-primary" href="/">
      <UiText en="Back to home" zh="回到首頁" /> <Icon name="arrow" size={17} />
    </a>
    <a class="text-link" href="/articles">
      <UiText en="Browse articles" zh="瀏覽文章" /> <Icon name="diagonal" size={17} />
    </a>
  </div>
</section>
<style>
  .error-page {
    padding-block: 64px 95px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    min-height: 640px;
  }
  .error-code {
    display: block;
    font-family: 'Space Grotesk Variable', var(--font-body);
    font-size: 66px;
    font-weight: 600;
    line-height: 1.2;
    color: var(--accent);
    margin-bottom: 28px;
  }
  h1 {
    margin-block: 17px 12px;
    font-weight: 600;
    letter-spacing: -1px;
    font-size: 30px;
    line-height: 1.5;
  }
  p {
    color: var(--muted);
    max-width: 390px;
    font-size: 16px;
    line-height: 2;
  }
  .error-actions {
    display: flex;
    align-items: center;
    gap: 25px;
    margin-top: 28px;
  }
  @media (max-width: 700px) {
    .error-page {
      padding-block: 37px 65px;
      min-height: 580px;
    }
    h1 {
      font-size: 25px;
    }
    .error-code {
      margin-bottom: 24px;
    }
  }
</style>
