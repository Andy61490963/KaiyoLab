---
import type { PublicEntry } from '../../lib/types';
interface Props {
  entry: PublicEntry;
  variant?: 'row' | 'card' | 'feature';
  index?: number;
  headingLevel?: 'h2' | 'h3';
}
const { entry, variant = 'row', headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const href = `/${entry.kind === 'project' ? 'projects' : 'articles'}/${encodeURIComponent(entry.slug)}`;
const date = new Date(entry.publishedAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
const readTime = Math.max(1, Math.ceil(entry.body.length / 450));
---

<article class:list={['journal-entry', `journal-entry-${variant}`]}>
  {variant === 'feature' && entry.cover && (
    <a class="journal-entry-cover" href={href} tabindex="-1" aria-hidden="true">
      <img src={entry.cover} alt="" loading="lazy" width="960" height="600" />
    </a>
  )}
  <div class="journal-entry-copy">
    <div class="journal-entry-meta">
      <time datetime={entry.publishedAt}>{date}</time>
      {entry.category && (
        <>
          <span aria-hidden="true">·</span>
          <a href={`/articles?category=${encodeURIComponent(entry.category)}`}>{entry.category}</a>
        </>
      )}
      {entry.kind === 'article' && (
        <>
          <span aria-hidden="true">·</span>
          <span>{readTime} min read</span>
        </>
      )}
      {entry.featured && <span class="journal-entry-featured">Featured</span>}
    </div>
    <Heading class="journal-entry-title">
      <a href={href}>{entry.title}</a>
    </Heading>
    {entry.excerpt && <p class="journal-entry-excerpt">{entry.excerpt}</p>}
    {entry.tags.length > 0 && (
      <ul class="journal-entry-tags" aria-label="Article tags">
        {entry.tags.slice(0, 3).map((tag) => (
          <li>
            <a href={`/articles?tag=${encodeURIComponent(tag)}`}>#{tag}</a>
          </li>
        ))}
      </ul>
    )}
  </div>
</article>

<style>
  .journal-entry {
    min-width: 0;
    padding-block: 22px;
    border-bottom: 1px solid var(--border);
  }
  .journal-entry-copy {
    min-width: 0;
  }
  .journal-entry-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
    margin-bottom: 7px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
  }
  .journal-entry-featured {
    padding: 1px 7px;
    border-radius: 3px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 12px;
    font-weight: 600;
  }
  .journal-entry-title {
    margin: 0;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }
  .journal-entry-title a {
    color: var(--accent);
    text-underline-offset: 4px;
  }
  .journal-entry a:hover {
    text-decoration: underline;
  }
  .journal-entry-excerpt {
    margin-top: 8px;
    font-size: 16px;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }
  .journal-entry-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    padding: 0;
    margin: 10px 0 0;
    color: var(--muted);
    list-style: none;
    font-size: 13px;
    overflow-wrap: anywhere;
  }
  .journal-entry-tags a,
  .journal-entry-meta a {
    text-underline-offset: 3px;
  }
  .journal-entry-cover {
    display: block;
    margin-bottom: 18px;
  }
  .journal-entry-cover img {
    width: 100%;
    max-height: 260px;
    border-radius: 6px;
    object-fit: cover;
  }
  .journal-entry-card {
    padding: 22px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
  }
  @media (max-width: 600px) {
    .journal-entry {
      padding-block: 18px;
    }
    .journal-entry-title {
      font-size: 18px;
    }
  }
</style>
