---
import Icon from './Icon.astro';
interface Props {
  title?: string;
  description?: string;
  icon?: string;
}
const {
  title = 'Nothing here yet',
  description = 'Published content will appear here.',
  icon = 'file',
} = Astro.props;
---

<div class="empty-state">
  <span class="empty-orbit">
    <Icon name={icon} size={27} />
  </span>
  <h3>{title}</h3>
  <p>{description}</p>
</div>
