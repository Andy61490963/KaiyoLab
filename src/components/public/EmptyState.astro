---
import Icon from './Icon.astro';
interface Props {
  title?: string;
  description?: string;
  icon?: string;
}
const {
  title = '目前沒有內容',
  description = '發布內容後會顯示在這裡',
  icon = 'file',
} = Astro.props;
---

<div class="empty-state">
  <span class="empty-orbit">
    <Icon name={icon} size={27} />
  </span>
  <h3>{title}</h3>
  <p>{description}</p>
</div>
