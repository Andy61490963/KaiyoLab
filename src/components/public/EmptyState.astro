---
import Ui from './UiText.astro';
import Icon from './Icon.astro';
import type { UiKey } from '../../lib/ui-language';
interface Props {
  title?: UiKey;
  description?: UiKey;
  icon?: string;
}
const {
  title = 'Nothing here yet',
  description = 'Published content will appear here.',
  icon = 'file',
} = Astro.props;
---

<div class="empty-state">
  <span class="empty-orbit">
    <Icon name={icon} size={27} />
  </span>
  <h3>
    <Ui text={title} />
  </h3>
  <p>
    <Ui text={description} />
  </p>
</div>
