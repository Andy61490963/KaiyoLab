---
import '../styles/global.css';
import '../styles/admin.css';
interface Props { title?: string; }
const { title = 'Admin' } = Astro.props;
---
<!doctype html>
<html lang="en" class="admin-document">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f8f4e6" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · KaiyoLab</title>
    <script is:inline>
      (() => {
        let theme;
        try { theme = localStorage.getItem('kaiyo-theme'); } catch {}
        document.documentElement.dataset.theme = theme === 'dark' || theme === 'light' ? theme : window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body><slot /></body>
</html>
