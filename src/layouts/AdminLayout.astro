---
import '../styles/global.css';
import '../styles/admin.css';
import { adminText } from '../lib/admin-language';
interface Props {
  title?: string;
}
const { title = 'Admin' } = Astro.props;
---

<!doctype html>
<html lang="zh-TW" class="admin-document" data-admin-language="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f8f4e6" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{adminText(title)} · KaiyoLab</title>
    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('kaiyo-theme');
        } catch {}
        document.documentElement.dataset.theme =
          theme === 'dark' || theme === 'light'
            ? theme
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        let language = 'zh-TW';
        try {
          language = localStorage.getItem('kaiyo-admin-language') === 'en' ? 'en' : 'zh-TW';
        } catch {}
        document.documentElement.dataset.adminLanguage = language;
        document.documentElement.lang = language;
      })();
    </script>
  </head>
  <body>
    <slot />
    <script>
      import { initializeDiagrams } from '../scripts/diagrams';
      initializeDiagrams();
    </script>
  </body>
</html>
