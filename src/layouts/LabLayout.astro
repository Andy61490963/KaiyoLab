---
import PublicLayout from './PublicLayout.astro';
import Text from '../components/lab/LabText.astro';
import { getSettings } from '../lib/content';
import { labInvitations, playfulExperiments, type LabExperiment } from '../lib/lab/experiments';
import '../styles/lab.css';
interface Props {
  experiment: LabExperiment;
}
const { experiment } = Astro.props;
const settings = await getSettings();
const invitation = labInvitations[experiment.slug];
const next =
  playfulExperiments[
    (playfulExperiments.findIndex((item) => item.slug === experiment.slug) + 1) %
      playfulExperiments.length
  ];
---

<PublicLayout
  settings={settings}
  title={invitation.title.en}
  titleTranslations={invitation.title}
  description={invitation.instruction.en}
>
  <div class="page-shell lab-shell">
    <nav class="lab-breadcrumb" aria-label="LAB">
      <a href="/lab">← LAB</a>
    </nav>
    <header>
      <h1 class="lab-heading">
        <Text {...invitation.title} />
      </h1>
      <p class="lab-intro">
        <Text {...invitation.instruction} />
      </p>
    </header>
    <section
      class="lab-demo"
      aria-label="Interactive tool"
      data-ui-label-en="Interactive tool"
      data-ui-label-zh="互動工具"
    >
      <slot />
      <noscript>
        <p class="lab-loading">
          <Text
            zh="啟用 JavaScript 即可操作實驗，下方的製作說明仍可直接閱讀"
            en="Enable JavaScript to play. You can still read how it works below."
          />
        </p>
      </noscript>
    </section>
    <details class="lab-technical">
      <summary>
        <Text zh="看看怎麼做的" en="How it works" />
      </summary>
      <h2>
        <Text {...experiment.title} />
      </h2>
      <ul
        class="lab-tags"
        aria-label="Technologies"
        data-ui-label-en="Technologies"
        data-ui-label-zh="使用技術"
      >
        {experiment.tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
      <div class="lab-technical-grid">
        {experiment.notes.map((note) => (
          <article>
            <h3>
              <Text {...note.title} />
            </h3>
            <p>
              <Text {...note.body} />
            </p>
          </article>
        ))}
      </div>
    </details>
    <nav class="lab-next" aria-label="Tools" data-ui-label-en="Tools" data-ui-label-zh="工具導覽">
      <a href="/lab">
        <Text zh="回到 LAB" en="Back to LAB" />
      </a>
      <a href={`/lab/${next.slug}`}>
        <Text {...labInvitations[next.slug].title} /> →
      </a>
    </nav>
  </div>
</PublicLayout>
