---
import '../styles/global.css';
import '../styles/public.css';
import Icon from '../components/public/Icon.astro';
import type { SiteSettings } from '../lib/types';
interface Props {
  settings: SiteSettings;
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
}
const {
  settings,
  title,
  description = settings.description,
  image = settings.heroImage || '/images/kaiyo-hero.png',
  article = false,
} = Astro.props;
const pageTitle = title
  ? `${title} · ${settings.siteName}`
  : `${settings.siteName} — ${settings.tagline}`;
const siteUrl = settings.siteUrl || Astro.url.origin;
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const navItems = [
  { href: '/', label: 'Home', icon: 'home' },
  { href: '/articles', label: 'Articles', icon: 'file' },
  { href: '/projects', label: 'Projects', icon: 'code' },
  { href: '/about', label: 'About Me', icon: 'user' },
];
const active = (href: string) =>
  href === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f4e6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c1b22" media="(prefers-color-scheme: dark)" />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${settings.siteName} RSS`}
      href="/rss.xml"
    />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image || '/images/kaiyo-hero.png', siteUrl).href} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={settings.siteName} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('kaiyo-theme');
          document.documentElement.dataset.theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
        } catch {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
  </head>
  <body class="public-site">
    <a class="skip-link" href="#main-content">
      Skip to main content
    </a>
    <header class="public-header">
      <div class="public-header-top">
        <a class="public-brand" href="/" aria-label={`${settings.siteName} home`}>
          <span>{settings.siteName}</span>
        </a>
        <div class="public-actions">
          <a class="icon-button" href="/articles#article-search" aria-label="Search articles">
            <Icon name="search" size={19} />
          </a>
          <button class="icon-button theme-toggle" type="button" aria-label="Toggle color theme">
            <span class="theme-sun">
              <Icon name="sun" size={20} />
            </span>
            <span class="theme-moon">
              <Icon name="moon" size={20} />
            </span>
          </button>
          <button
            class="icon-button mobile-menu-toggle"
            type="button"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-nav"
          >
            <Icon name="menu" size={21} />
          </button>
        </div>
      </div>
      <p class="public-intro">
        I\'m <a href="/about">{settings.authorName || settings.siteName}</a>
        <br />
        {settings.bio || 'Software engineer sharing development notes, open-source projects, and things worth documenting.'}
      </p>
      <nav class="public-nav" aria-label="Main navigation">
        {navItems.map((item) => (
          <a
            class:list={{ active: active(item.href) }}
            aria-current={active(item.href) ? 'page' : undefined}
            href={item.href}
          >
            <span class={`nav-icon nav-icon-${item.icon}`}>
              <Icon name={item.icon} size={20} />
            </span>
            {item.label}
          </a>
        ))}
      </nav>
      <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" hidden>
        {navItems.map((item) => (
          <a
            class:list={{ active: active(item.href) }}
            aria-current={active(item.href) ? 'page' : undefined}
            href={item.href}
          >
            <span class={`nav-icon nav-icon-${item.icon}`}>
              <Icon name={item.icon} size={20} />
            </span>
            {item.label}
          </a>
        ))}
      </nav>
      <div class="public-sidebar-bottom">
        <div class="public-socials">
          {settings.socialLinks.map((link) => (
            <a href={link.url} target="_blank" rel="noopener noreferrer">
              {link.label}
              <Icon name="diagonal" size={13} />
            </a>
          ))}
          <a href="/rss.xml">
            <Icon name="rss" size={17} /> RSS Subscribe
          </a>
        </div>
        <a class="public-admin-link" href="/admin">
          Admin <Icon name="diagonal" size={13} />
        </a>
      </div>
    </header>
    <div class="public-frame">
      <main id="main-content">
        <slot />
      </main>
      <footer class="public-footer">
        <div class="public-footer-links">
          <a href="/rss.xml">RSS Subscribe</a>
          <a href="/about">About Me</a>
          {settings.socialLinks.map((link) => (
            <a href={link.url} target="_blank" rel="noopener noreferrer">
              {link.label}
            </a>
          ))}
          <a href="/admin">Admin</a>
        </div>
        <p>
          © {new Date().getFullYear()} {settings.authorName || settings.siteName}
          <span>Software notes and projects maintained by the site owner</span>
        </p>
      </footer>
    </div>
    <script>
      const themeButton = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const updateThemeLabel = () => {
        if (themeButton)
          themeButton.setAttribute(
            'aria-label',
            document.documentElement.dataset.theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme',
          );
      };
      updateThemeLabel();
      themeButton?.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        try {
          localStorage.setItem('kaiyo-theme', theme);
        } catch {}
        updateThemeLabel();
      });
      const menuButton = document.querySelector<HTMLButtonElement>('.mobile-menu-toggle');
      const menu = document.getElementById('mobile-nav');
      menuButton?.addEventListener('click', () => {
        const open = menuButton.getAttribute('aria-expanded') !== 'true';
        menuButton.setAttribute('aria-expanded', String(open));
        menuButton.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        if (menu) menu.hidden = !open;
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menu && !menu.hidden) {
          menu.hidden = true;
          menuButton?.setAttribute('aria-expanded', 'false');
          menuButton?.setAttribute('aria-label', 'Open menu');
          menuButton?.focus();
        }
      });
      document.querySelectorAll<HTMLElement>('.prose pre').forEach((pre) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'copy-code';
        button.textContent = 'Copy';
        button.setAttribute('aria-label', 'Copy code');
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(pre.querySelector('code')?.textContent || '');
            button.textContent = 'Copied';
          } catch {
            button.textContent = 'Copy failed';
          }
          setTimeout(() => {
            button.textContent = 'Copy';
          }, 2000);
        });
        pre.appendChild(button);
      });
    </script>
  </body>
</html>
