---
import PublicLayout from '../layouts/PublicLayout.astro';
import ErrorView from '../components/public/ErrorView.astro';
import { defaultSettings } from '../lib/defaults';

Astro.response.status = 500;
---

<PublicLayout
  settings={defaultSettings}
  title="Temporarily unavailable"
  titleKey="Temporarily unavailable"
  description="KaiyoLab is temporarily unavailable. Please try again shortly."
>
  <ErrorView
    code="500"
    title="Temporarily unavailable"
    description="Refresh the page in a moment. If the problem persists, contact the site owner."
  />
</PublicLayout>
