---
import PublicLayout from '../layouts/PublicLayout.astro';
import EntryCard from '../components/public/EntryCard.astro';
import ProjectCard from '../components/public/ProjectCard.astro';
import Icon from '../components/public/Icon.astro';
import { getSettings, listPublished, listTaxonomies } from '../lib/content';
import { renderMarkdown } from '../lib/markdown';

const [settings, recent, featured, selectedProjects, taxonomy] = await Promise.all([
  getSettings(),
  listPublished({ kind: 'article', pageSize: 5 }),
  listPublished({ kind: 'article', featured: true, pageSize: 3 }),
  listPublished({ kind: 'project', featured: true, pageSize: 3 }),
  listTaxonomies(),
]);
const projects = selectedProjects.total ? selectedProjects : await listPublished({ kind: 'project', pageSize: 3 });
const recentIds = new Set(recent.items.map((entry) => entry.id));
const additionalFeatured = featured.items.filter((entry) => !recentIds.has(entry.id));
const homeIntro = await renderMarkdown(settings.homeIntro);
const hasTitle = homeIntro.toc.some((heading) => heading.depth === 1);
---

<PublicLayout settings={settings}>
  <div class="page-shell home-content">
    <header class="home-introduction">
      {!hasTitle && <h1 class="page-title">I'm {settings.authorName || settings.siteName}</h1>}
      <div class="home-intro-markdown prose" set:html={homeIntro.html} />
      <a class="home-inline-link" href="/about">More about me <span aria-hidden="true">→</span></a>
      {settings.heroImage && settings.heroImage !== '/images/kaiyo-hero.png' && (
        <img class="home-custom-image" src={settings.heroImage} alt={`${settings.siteName} home image`} width="960" height="400" fetchpriority="high" />
      )}
    </header>
    <section class="home-section" aria-labelledby="recent-articles-title">
      <div class="home-section-heading">
        <h2 id="recent-articles-title">Latest Articles</h2>
        <a href="/articles">All articles <span aria-hidden="true">→</span></a>
      </div>
      {recent.items.length ? (
        <div class="home-article-list">{recent.items.map((entry) => <EntryCard entry={entry} />)}</div>
      ) : <p class="home-empty">No published articles yet. New writing will appear here.</p>}
    </section>
    {additionalFeatured.length > 0 && (
      <section class="home-section" aria-labelledby="featured-articles-title">
        <div class="home-section-heading"><h2 id="featured-articles-title">Featured Articles</h2></div>
        <div class="home-article-list">{additionalFeatured.map((entry) => <EntryCard entry={entry} />)}</div>
      </section>
    )}
    <section class="home-section" aria-labelledby="featured-projects-title">
      <div class="home-section-heading">
        <h2 id="featured-projects-title">{selectedProjects.total ? 'Selected Projects' : 'Projects'}</h2>
        <a href="/projects">All projects <span aria-hidden="true">→</span></a>
      </div>
      {projects.items.length ? (
        <div class="home-project-list">{projects.items.map((entry) => <ProjectCard entry={entry} headingLevel="h3" />)}</div>
      ) : <p class="home-empty">No published projects yet. Projects will appear here when they are ready to share.</p>}
    </section>
    {taxonomy.categories.length > 0 && (
      <section class="home-section home-topics" aria-labelledby="topics-title">
        <h2 id="topics-title">Browse by Topic</h2>
        <ul>{taxonomy.categories.map((category) => (
          <li><a href={`/articles?category=${encodeURIComponent(category.name)}`}>{category.name}</a></li>
        ))}</ul>
      </section>
    )}
    <p class="home-subscribe"><Icon name="rss" size={18} /><a href="/rss.xml">Subscribe to new articles via RSS</a></p>
  </div>
</PublicLayout>
