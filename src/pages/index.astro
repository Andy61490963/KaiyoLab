---
import PublicLayout from '../layouts/PublicLayout.astro';
import EntryCard from '../components/public/EntryCard.astro';
import ProjectCard from '../components/public/ProjectCard.astro';
import Icon from '../components/public/Icon.astro';
import { getSettings, listPublished, listTaxonomies } from '../lib/content';
import { renderMarkdown } from '../lib/markdown';
const [settings, recent, featured, projects, taxonomy] = await Promise.all([
  getSettings(),
  listPublished({ kind: 'article', pageSize: 5 }),
  listPublished({ kind: 'article', featured: true, pageSize: 3 }),
  listPublished({ kind: 'project', featured: true, pageSize: 3 }),
  listTaxonomies(),
]);
const recentIds = new Set(recent.items.map((entry) => entry.id));
const additionalFeatured = featured.items.filter((entry) => !recentIds.has(entry.id));
const homeIntro = await renderMarkdown(settings.homeIntro);
---

<PublicLayout settings={settings}>
  <div class="page-shell home-content">
    <header class="home-introduction">
      <div class="home-intro-markdown prose" set:html={homeIntro.html} />
      <a class="home-inline-link" href="/about">
        More about me <span aria-hidden="true">→</span>
      </a>
      {settings.heroImage && settings.heroImage !== '/images/kaiyo-hero.png' && (
        <img
          class="home-custom-image"
          src={settings.heroImage}
          alt={`${settings.siteName} home image`}
          width="960"
          height="400"
          fetchpriority="high"
        />
      )}
    </header>

    <section class="home-section" aria-labelledby="recent-articles-title">
      <div class="home-section-heading">
        <h2 id="recent-articles-title">Latest Articles</h2>
        <a href="/articles">
          All articles <span aria-hidden="true">→</span>
        </a>
      </div>
      {recent.items.length ? (
        <div class="home-article-list">
          {recent.items.map((entry) => (
            <EntryCard entry={entry} />
          ))}
        </div>
      ) : (
        <p class="home-empty">No published articles yet.</p>
      )}
    </section>

    {additionalFeatured.length > 0 && (
      <section class="home-section" aria-labelledby="featured-articles-title">
        <div class="home-section-heading">
          <h2 id="featured-articles-title">Featured Articles</h2>
        </div>
        <div class="home-article-list">
          {additionalFeatured.map((entry) => (
            <EntryCard entry={entry} />
          ))}
        </div>
      </section>
    )}

    <section class="home-section" aria-labelledby="featured-projects-title">
      <div class="home-section-heading">
        <h2 id="featured-projects-title">Featured Projects</h2>
        <a href="/projects">
          All projects <span aria-hidden="true">→</span>
        </a>
      </div>
      {projects.items.length ? (
        <div class="home-project-list">
          {projects.items.map((entry) => (
            <ProjectCard entry={entry} headingLevel="h3" />
          ))}
        </div>
      ) : (
        <p class="home-empty">No featured projects yet. Browse the projects page for more.</p>
      )}
    </section>

    {taxonomy.categories.length > 0 && (
      <section class="home-section home-topics" aria-labelledby="topics-title">
        <h2 id="topics-title">Browse by Topic</h2>
        <ul>
          {taxonomy.categories.map((category) => (
            <li>
              <a href={`/articles?category=${encodeURIComponent(category.name)}`}>
                {category.name}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <p class="home-subscribe">
      <Icon name="rss" size={18} />
      <span>
        <a href="/rss.xml">Subscribe to new articles via RSS</a>
      </span>
    </p>
  </div>
</PublicLayout>

<style>
  .home-content {
    padding-block: 64px 48px;
  }
  .home-introduction {
    max-width: 820px;
    margin-bottom: 52px;
  }
  .home-intro-markdown :global(h1) {
    margin: 0 0 24px;
    font-size: clamp(30px, 3.2vw, 42px);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.035em;
  }
  .home-intro-markdown :global(p) {
    margin: 0 0 16px;
    color: var(--text);
    font-size: 18px;
    line-height: 1.9;
  }
  .home-intro-markdown :global(p:first-of-type) {
    font-size: 21px;
    line-height: 1.75;
  }
  .home-intro-markdown :global(h2),
  .home-intro-markdown :global(h3) {
    margin-block: 24px 12px;
  }
  .home-intro-markdown :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .home-inline-link,
  .home-section-heading a,
  .home-topics a,
  .home-subscribe a {
    color: var(--accent);
    font-weight: 600;
    text-underline-offset: 4px;
  }
  .home-inline-link:hover,
  .home-section-heading a:hover,
  .home-topics a:hover,
  .home-subscribe a:hover {
    text-decoration: underline;
  }
  .home-custom-image {
    width: 100%;
    max-height: 300px;
    margin-top: 28px;
    border-radius: 6px;
    object-fit: cover;
  }
  .home-section {
    margin-block: 42px;
  }
  .home-section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
  }
  .home-section h2 {
    font-size: 25px;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: -0.025em;
  }
  .home-section-heading a {
    flex-shrink: 0;
    font-size: 15px;
  }
  .home-article-list {
    border-top: 1px solid var(--border);
  }
  .home-project-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .home-empty {
    padding: 20px 0;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 16px;
  }
  .home-topics ul {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    padding: 0;
    margin: 18px 0 0;
    list-style: none;
    font-size: 16px;
  }
  .home-subscribe {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 24px;
    margin-top: 48px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 15px;
    line-height: 1.8;
  }
  @media (max-width: 1199px) {
    .home-project-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .home-project-list {
      grid-template-columns: minmax(0, 1fr);
    }
    .home-content {
      padding-block: 32px;
    }
    .home-introduction {
      margin-bottom: 36px;
    }
    .home-intro-markdown :global(p) {
      font-size: 16px;
    }
    .home-intro-markdown :global(p:first-of-type) {
      font-size: 18px;
    }
    .home-section {
      margin-block: 32px;
    }
    .home-section h2 {
      font-size: 23px;
    }
    .home-section-heading a {
      font-size: 14px;
    }
  }
</style>
