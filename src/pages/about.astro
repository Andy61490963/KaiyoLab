---
import PublicLayout from '../layouts/PublicLayout.astro';
import { getSettings } from '../lib/content';
import { renderMarkdown } from '../lib/markdown';

const settings = await getSettings();
const rendered = await renderMarkdown(
  settings.about ||
    "# About Me\n\nHey, I'm a software engineer sharing development notes and personal projects.",
);
---

<PublicLayout settings={settings} title="About Me" description={settings.bio || settings.description}>
  <article class="page-shell about-page">
    <div class="about-markdown prose" set:html={rendered.html} />
  </article>
</PublicLayout>
