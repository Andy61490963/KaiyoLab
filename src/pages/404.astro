---
import PublicLayout from '../layouts/PublicLayout.astro';
import ErrorView from '../components/public/ErrorView.astro';
import { getSettings } from '../lib/content';
import { defaultSettings } from '../lib/defaults';

Astro.response.status = 404;
const settings = await getSettings().catch(() => defaultSettings);
---

<PublicLayout
  settings={settings}
  title="Page not found"
  titleKey="Page not found"
  description="The requested page could not be found."
>
  <ErrorView
    code="404"
    title="Page not found"
    description="Check the URL, or head back home to browse articles and projects."
  />
</PublicLayout>
