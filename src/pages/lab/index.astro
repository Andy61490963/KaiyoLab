---
import Ui from '../../components/public/UiText.astro';
import PublicLayout from '../../layouts/PublicLayout.astro';
import ProjectCard from '../../components/public/ProjectCard.astro';
import EmptyState from '../../components/public/EmptyState.astro';
import Pagination from '../../components/public/Pagination.astro';
import CollectionControls from '../../components/public/CollectionControls.astro';
import Icon from '../../components/public/Icon.astro';
import { uiLabel } from '../../lib/ui-language';
import { getSettings, listPublished } from '../../lib/content';
import { publicListingHref, projectList, readPublicListing } from '../../lib/listing';
import { LAB_CATEGORY } from '../../lib/lab';
import Text from '../../components/lab/LabText.astro';
import { experiments } from '../../lib/lab/experiments';
import '../../styles/lab.css';
import '../../styles/lab-index.css';

const q = (Astro.url.searchParams.get('q') || '').trim().slice(0, 200);
const options = readPublicListing(Astro.url.searchParams, projectList);
const [settings, result] = await Promise.all([
  getSettings(),
  listPublished({ kind: 'project', category: LAB_CATEGORY, q, ...options }),
]);
const showPublished = result.total > 0 || !!q;
---

<PublicLayout
  settings={settings}
  title="LAB"
  titleKey="LAB"
  description="Frontend tools for motion, responsive layouts, SVG shapes, 3D carousels and particle backgrounds."
>
  <div class="page-shell lab-page lab-index">
    <header class="collection-header">
      <h1 class="page-title">
        <Icon name="flask" size={36} />
        <Ui text="LAB" />
      </h1>
      <p>
        <Text
          zh="前端工具，調整、預覽，再帶回自己的專案"
          en="Frontend tools to tune, preview and use in your own projects"
        />
      </p>
    </header>
    <section
      class="lab-experiment-index"
      aria-label="Frontend tools"
      data-ui-label-en="Frontend tools"
      data-ui-label-zh="前端工具"
    >
      {experiments.map((experiment) => (
        <a class="lab-index-row" href={`/lab/${experiment.slug}`}>
          <span class="lab-row-number" aria-hidden="true">
            {experiment.number}
          </span>
          <div>
            <h2>
              <Text {...experiment.title} />
            </h2>
            <p class="lab-row-description">
              <Text {...experiment.description} />
            </p>
            <ul class="lab-tags">
              {experiment.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          </div>
          <span class="lab-row-arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      ))}
    </section>
    <section
      id="lab-published"
      data-public-collection
      data-collection-id="lab"
      data-collection-anchor="lab-published"
      hidden={!showPublished}
      aria-labelledby={showPublished ? 'lab-published-title' : undefined}
    >
      {showPublished && (
        <>
          <header class="lab-published-heading">
            <h2 id="lab-published-title">
              <Text zh="站長作品" en="Published projects" />
            </h2>
          </header>
          <CollectionControls
            config={projectList}
            sort={options.sort}
            q={q}
            searchLabel="Search LAB"
            searchId="lab-search"
            anchor="lab-published"
          />
          <div data-collection-results data-total={result.total} data-page={result.page}>
            <div class="collection-results">
              {result.pages === 1 && result.total > 0 && (
                <span>
                  <Ui
                    text={result.total === 1 ? '{count} experiment' : '{count} experiments'}
                    values={{ count: result.total }}
                  />
                </span>
              )}
              {q && (
                <a
                  href={`${publicListingHref(Astro.url, { q: null, page: null })}#lab-published`}
                  data-collection-link
                >
                  <Ui text="Clear filters" /> <Icon name="close" size={14} />
                </a>
              )}
            </div>
            <section class="lab-grid" {...uiLabel('LAB list')}>
              {result.items.length ? (
                result.items.map((entry) => <ProjectCard entry={entry} />)
              ) : (
                <EmptyState
                  title="No matching experiments"
                  description="Try another keyword or clear the search."
                  icon="flask"
                />
              )}
            </section>
            <Pagination
              page={result.page}
              pages={result.pages}
              total={result.total}
              pageSize={result.pageSize}
              anchor="lab-published"
            />
          </div>
        </>
      )}
    </section>
  </div>
</PublicLayout>

<style>
  .lab-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .lab-grid :global(.empty-state) {
    grid-column: 1 / -1;
  }
  @media (max-width: 1199px) {
    .lab-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 620px) {
    .lab-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
