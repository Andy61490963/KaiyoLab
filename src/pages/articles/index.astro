---
import Ui from '../../components/public/UiText.astro';
import PublicLayout from '../../layouts/PublicLayout.astro';
import EntryCard from '../../components/public/EntryCard.astro';
import Pagination from '../../components/public/Pagination.astro';
import CollectionControls from '../../components/public/CollectionControls.astro';
import Icon from '../../components/public/Icon.astro';
import { uiLabel, type UiKey } from '../../lib/ui-language';
import { getSettings, listPublished, listTaxonomies } from '../../lib/content';
import { articleList, publicListingHref, readPublicListing } from '../../lib/listing';
import '../../styles/public-collection.css';
const q = (Astro.url.searchParams.get('q') || '').trim().slice(0, 200);
const category = Astro.url.searchParams.get('category') || '';
const tag = Astro.url.searchParams.get('tag') || '';
const options = readPublicListing(Astro.url.searchParams, articleList);
const [settings, result, taxonomy] = await Promise.all([
  getSettings(),
  listPublished({ kind: 'article', q, category, tag, ...options }),
  listTaxonomies(),
]);
const filtered = Boolean(q || category || tag);
const filterLink = (key: 'q' | 'category' | 'tag', value: string) =>
  publicListingHref(Astro.url, { [key]: value, page: null });
const clearLink = publicListingHref(Astro.url, { q: null, category: null, tag: null, page: null });
const chips: Array<{ key: 'q' | 'category' | 'tag'; value: string; label: UiKey }> = [
  { key: 'q', value: q, label: 'Remove search: {value}' },
  { key: 'category', value: category, label: 'Remove category: {value}' },
  { key: 'tag', value: tag, label: 'Remove tag: {value}' },
];
---

<PublicLayout
  settings={settings}
  title="Articles"
  titleKey="Articles"
  description="Development notes, practical guides, and things worth documenting."
>
  <div class="page-shell">
    <header class="collection-header">
      <h1>
        <Ui text="Articles" />
      </h1>
    </header>
    <section data-public-collection data-collection-id="articles">
      {(result.total > 0 || filtered) && (
        <>
          <CollectionControls config={articleList} sort={options.sort} q={q} help />
          <div class="collection-filters">
            {taxonomy.categories.length > 0 && (
              <nav class="category-nav" {...uiLabel('Article categories')}>
                <a
                  data-collection-link
                  href={filterLink('category', '')}
                  class:list={{ active: !category }}
                  aria-current={!category ? 'true' : undefined}
                >
                  <Ui text="All categories" />
                </a>
                {taxonomy.categories.map((item) => (
                  <a
                    data-collection-link
                    href={filterLink('category', item.name)}
                    class:list={{ active: category === item.name }}
                    aria-current={category === item.name ? 'true' : undefined}
                    data-original-content
                    translate="no"
                  >
                    {item.name}
                  </a>
                ))}
              </nav>
            )}
            {taxonomy.tags.length > 0 && (
              <details class="tag-cloud collection-tag-filter" id="article-tag-filter">
                <summary id="article-tag-filter-toggle">
                  <Ui text="Tags" /> <span class="tag-filter-count">{taxonomy.tags.length}</span>
                </summary>
                <div>
                  {taxonomy.tags.map((item) => (
                    <a
                      data-collection-link
                      href={filterLink('tag', item.name)}
                      class:list={{ active: tag === item.name }}
                      aria-current={tag === item.name ? 'true' : undefined}
                      data-original-content
                      translate="no"
                    >
                      #{item.name}
                    </a>
                  ))}
                </div>
              </details>
            )}
          </div>
        </>
      )}
      <div data-collection-results data-total={result.total} data-page={result.page}>
        {((result.total > 0 && result.pages === 1) || filtered) && (
          <div class="collection-results">
            {result.total > 0 && result.pages === 1 && (
              <span>
                <Ui
                  text={result.total === 1 ? '{count} article' : '{count} articles'}
                  values={{ count: result.total }}
                />
              </span>
            )}
            {filtered && (
              <>
                <ul class="collection-filter-chips">
                  {chips
                    .filter((chip) => chip.value)
                    .map((chip) => (
                      <li>
                        <a
                          data-collection-link
                          data-filter-chip={chip.key}
                          href={filterLink(chip.key, '')}
                          {...uiLabel(chip.label, { value: chip.value })}
                        >
                          <span data-original-content translate="no">
                            {chip.key === 'tag' ? '#' : ''}
                            {chip.value}
                          </span>
                          <Icon name="close" size={14} />
                        </a>
                      </li>
                    ))}
                </ul>
                {chips.filter((chip) => chip.value).length > 1 && (
                  <a data-collection-link href={clearLink}>
                    <Ui text="Clear filters" />
                  </a>
                )}
              </>
            )}
          </div>
        )}
        <div class="article-list">
          {result.items.length ? (
            result.items.map((entry, index) => (
              <EntryCard
                entry={entry}
                headingLevel="h2"
                index={index + (result.page - 1) * result.pageSize}
              />
            ))
          ) : (
            <p class="collection-empty">
              <Ui text={filtered ? 'No matching articles' : 'No published articles yet'} />
            </p>
          )}
        </div>
        <Pagination
          page={result.page}
          pages={result.pages}
          total={result.total}
          pageSize={result.pageSize}
        />
      </div>
    </section>
  </div>
</PublicLayout>
