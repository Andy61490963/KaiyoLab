---
import PublicLayout from '../../layouts/PublicLayout.astro';
import EntryCard from '../../components/public/EntryCard.astro';
import EmptyState from '../../components/public/EmptyState.astro';
import Pagination from '../../components/public/Pagination.astro';
import Icon from '../../components/public/Icon.astro';
import { getSettings, listPublished, listTaxonomies } from '../../lib/content';
const q = Astro.url.searchParams.get('q') || '';
const category = Astro.url.searchParams.get('category') || '';
const tag = Astro.url.searchParams.get('tag') || '';
const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);
const [settings, result, taxonomy] = await Promise.all([
  getSettings(),
  listPublished({ kind: 'article', q, category, tag, page, pageSize: 8 }),
  listTaxonomies(),
]);
const filterLink = (key: 'category' | 'tag', value: string) => {
  const params = new URLSearchParams();
  if (q) params.set('q', q);
  if (category) params.set('category', category);
  if (tag) params.set('tag', tag);
  if (value) params.set(key, value);
  else params.delete(key);
  return `/articles${params.size ? `?${params}` : ''}`;
};
---

<PublicLayout settings={settings} title="Articles" description="Development notes, practical guides, and things worth documenting.">
  <div class="page-shell">
    <header class="collection-header">
      <h1>Articles</h1>
      <p>Development notes, practical guides, and things worth documenting.</p>
    </header>
    <div class="collection-layout">
      <aside class="collection-sidebar">
        <h2>Categories</h2>
        <nav class="category-nav" aria-label="Article categories">
          <a href={filterLink('category', '')} class:list={{ active: !category }} aria-current={!category ? 'true' : undefined}>All categories</a>
          {taxonomy.categories.map((item) => (
            <a href={filterLink('category', item.name)} class:list={{ active: category === item.name }} aria-current={category === item.name ? 'true' : undefined}>{item.name}</a>
          ))}
        </nav>
        {taxonomy.tags.length > 0 && (
          <div class="tag-cloud">
            <h2>Tags</h2>
            <div>
              {tag && <a href={filterLink('tag', '')}>Clear tag</a>}
              {taxonomy.tags.map((item) => (
                <a href={filterLink('tag', item.name)} class:list={{ active: tag === item.name }} aria-current={tag === item.name ? 'true' : undefined}>#{item.name}</a>
              ))}
            </div>
          </div>
        )}
      </aside>
      <div class="collection-content">
        <form class="search-form" method="get" action="/articles" role="search">
          <label class="sr-only" for="article-search">Search articles</label>
          <Icon name="search" size={19} />
          <input id="article-search" type="search" name="q" value={q} maxlength="200" placeholder="Search titles or content…" autocomplete="off" />
          {category && <input type="hidden" name="category" value={category} />}
          {tag && <input type="hidden" name="tag" value={tag} />}
          <button type="submit">Search <Icon name="arrow" size={16} /></button>
        </form>
        <div class="collection-results">
          <span>{result.total} {result.total === 1 ? 'article' : 'articles'}{q && ` matching “${q}”`}{category && ` in ${category}`}{tag && ` tagged #${tag}`}</span>
          {(q || tag || category) && <a href="/articles">Clear filters <Icon name="close" size={14} /></a>}
          <span class="result-order">Newest first</span>
        </div>
        <div class="article-list">
          {result.items.length ? result.items.map((entry, index) => (
            <EntryCard entry={entry} headingLevel="h2" index={index + (result.page - 1) * 8} />
          )) : (
            <EmptyState title={q || tag || category ? 'No matching articles' : 'No published articles yet'} description={q || tag || category ? 'Try another keyword or clear the category and tag filters.' : 'Published articles will appear here.'} />
          )}
        </div>
        <Pagination page={result.page} pages={result.pages} />
      </div>
    </div>
  </div>
</PublicLayout>
