---
import UiText from '../../components/public/UiText.astro';
import PublicLayout from '../../layouts/PublicLayout.astro';
import EntryCard from '../../components/public/EntryCard.astro';
import EmptyState from '../../components/public/EmptyState.astro';
import Pagination from '../../components/public/Pagination.astro';
import Icon from '../../components/public/Icon.astro';
import { getSettings, listPublished, listTaxonomies } from '../../lib/content';
const q = Astro.url.searchParams.get('q') || '';
const category = Astro.url.searchParams.get('category') || '';
const tag = Astro.url.searchParams.get('tag') || '';
const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);
const [settings, result, taxonomy] = await Promise.all([
  getSettings(),
  listPublished({ kind: 'article', q, category, tag, page, pageSize: 8 }),
  listTaxonomies(),
]);
const filterLink = (key: 'category' | 'tag', value: string) => {
  const params = new URLSearchParams();
  if (q) params.set('q', q);
  if (category) params.set('category', category);
  if (tag) params.set('tag', tag);
  if (value) params.set(key, value);
  else params.delete(key);
  return `/articles${params.size ? `?${params}` : ''}`;
};
---

<PublicLayout
  settings={settings}
  title="Articles"
  description="Development notes, practical guides, and things worth documenting."
>
  <div class="page-shell">
    <header class="collection-header">
      <h1>
        <UiText en="Articles" zh="文章" />
      </h1>
      <p>
        <UiText
          en="Development notes, practical guides, and things worth documenting."
          zh="開發筆記、實作指南，以及值得記錄的事。"
        />
      </p>
    </header>
    <div class="collection-layout">
      <aside class="collection-sidebar">
        <h2>
          <UiText en="Categories" zh="分類" />
        </h2>
        <nav class="category-nav" aria-label="Article categories" data-ui-label="categories">
          <a
            href={filterLink('category', '')}
            class:list={{ active: !category }}
            aria-current={!category ? 'true' : undefined}
          >
            <UiText en="All categories" zh="所有分類" />
          </a>
          {taxonomy.categories.map((item) => (
            <a
              href={filterLink('category', item.name)}
              class:list={{ active: category === item.name }}
              aria-current={category === item.name ? 'true' : undefined}
            >
              {item.name}
            </a>
          ))}
        </nav>
        {taxonomy.tags.length > 0 && (
          <div class="tag-cloud">
            <h2>
              <UiText en="Tags" zh="標籤" />
            </h2>
            <div>
              {tag && (
                <a href={filterLink('tag', '')}>
                  <UiText en="Clear tag" zh="清除標籤" />
                </a>
              )}
              {taxonomy.tags.map((item) => (
                <a
                  href={filterLink('tag', item.name)}
                  class:list={{ active: tag === item.name }}
                  aria-current={tag === item.name ? 'true' : undefined}
                >
                  #{item.name}
                </a>
              ))}
            </div>
          </div>
        )}
      </aside>
      <div class="collection-content">
        <form class="search-form" method="get" action="/articles" role="search">
          <label class="sr-only" for="article-search">
            <UiText en="Search articles" zh="搜尋文章" />
          </label>
          <Icon name="search" size={19} />
          <input
            id="article-search"
            type="search"
            name="q"
            value={q}
            maxlength="200"
            placeholder="Search titles or content…"
            data-ui-placeholder="searchPlaceholder"
            autocomplete="off"
          />
          {category && <input type="hidden" name="category" value={category} />}
          {tag && <input type="hidden" name="tag" value={tag} />}
          <button type="submit">
            <UiText en="Search" zh="搜尋" /> <Icon name="arrow" size={16} />
          </button>
        </form>
        <div class="collection-results">
          <span>
            <UiText
              en={`${result.total} ${result.total === 1 ? 'article' : 'articles'}${q ? ` matching “${q}”` : ''}${category ? ` in ${category}` : ''}${tag ? ` tagged #${tag}` : ''}`}
              zh={`共 ${result.total} 篇文章${q ? `，關鍵字「${q}」` : ''}${category ? `，分類：${category}` : ''}${tag ? `，標籤：#${tag}` : ''}`}
            />
          </span>
          {(q || tag || category) && (
            <a href="/articles">
              <UiText en="Clear filters" zh="清除篩選" /> <Icon name="close" size={14} />
            </a>
          )}
          <span class="result-order">
            <UiText en="Newest first" zh="最新優先" />
          </span>
        </div>
        <div class="article-list">
          {result.items.length ? (
            result.items.map((entry, index) => (
              <EntryCard entry={entry} headingLevel="h2" index={index + (result.page - 1) * 8} />
            ))
          ) : (
            <EmptyState
              title={q || tag || category ? 'No matching articles' : 'No published articles yet'}
              titleZh={q || tag || category ? '沒有符合條件的文章' : '尚無已發布文章'}
              description={
                q || tag || category
                  ? 'Try another keyword or clear the category and tag filters.'
                  : 'Published articles will appear here.'
              }
              descriptionZh={
                q || tag || category
                  ? '請嘗試其他關鍵字，或清除分類與標籤篩選。'
                  : '已發布的文章會出現在這裡。'
              }
            />
          )}
        </div>
        <Pagination page={result.page} pages={result.pages} />
      </div>
    </div>
  </div>
</PublicLayout>
