---
import '../../styles/article-reading.css';
import ArticleViews from '../../components/public/ArticleViews.astro';
import Ui from '../../components/public/UiText.astro';
import PublicLayout from '../../layouts/PublicLayout.astro';
import EntryCard from '../../components/public/EntryCard.astro';
import Icon from '../../components/public/Icon.astro';
import { uiLabel } from '../../lib/ui-language';
import { getSettings, getPublished, listPublished } from '../../lib/content';
import { renderMarkdown } from '../../lib/markdown';
const [settings, entry] = await Promise.all([
  getSettings(),
  getPublished('article', Astro.params.slug || ''),
]);
if (!entry) return Astro.rewrite('/404');
const rendered = await renderMarkdown(entry.body);
const related = await listPublished({
  kind: 'article',
  category: entry.category || undefined,
  pageSize: 4,
});
const date = new Date(entry.publishedAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<PublicLayout
  settings={settings}
  title={entry.seoTitle || entry.title}
  description={entry.seoDescription || entry.excerpt}
  image={entry.cover || undefined}
  article
>
  <article class="page-shell article-page article-reading">
    <a class="back-link" href="/articles">
      <Icon name="back" size={17} /> <Ui text="Back to articles" />
    </a>
    <header class:list={['article-hero', { 'has-cover': Boolean(entry.cover) }]}>
      <div class="article-heading">
        <div class="entry-meta">
          <a
            class="category-label"
            href={`/articles?category=${encodeURIComponent(entry.category)}`}
          >
            {entry.category || 'Notes'}
          </a>
          <span class="meta-dot">·</span>
          <time datetime={entry.publishedAt}>{date}</time>
          <span class="meta-dot">·</span>
          <span>
            <Ui text="{count} min read" values={{ count: rendered.readingMinutes }} />
          </span>
          <ArticleViews entryId={entry.id} />
        </div>
        <h1 data-original-content translate="no">
          {entry.title}
        </h1>
        {entry.excerpt && (
          <p class="article-lead" data-original-content translate="no">
            {entry.excerpt}
          </p>
        )}
        <div class="article-byline">
          <img src={settings.avatar || '/favicon.svg'} alt="" width="34" height="34" />
          <span>{settings.authorName || settings.siteName}</span>
          <span class="byline-line"></span>
          <div class="entry-tags">
            {entry.tags.map((tag) => (
              <a href={`/articles?tag=${encodeURIComponent(tag)}`}>#{tag}</a>
            ))}
          </div>
        </div>
      </div>
      {entry.cover && (
        <figure class="article-cover">
          <img
            src={entry.cover}
            alt={entry.coverAlt || entry.title}
            width="1280"
            height="720"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      )}
    </header>
    {rendered.toc.length > 0 && (
      <details class="mobile-toc">
        <summary>
          <Ui text="Table of contents" />
        </summary>
        <nav {...uiLabel('Mobile article table of contents')}>
          {rendered.toc.map((item) => (
            <a
              data-article-toc-link
              class:list={{ 'toc-sub': item.depth > 2 }}
              href={`#${item.id}`}
            >
              {item.text}
            </a>
          ))}
        </nav>
      </details>
    )}
    <div class:list={['reading-layout', { 'without-toc': rendered.toc.length === 0 }]}>
      <div class="article-body">
        <div class="prose" data-original-content translate="no" set:html={rendered.html} />
        <div class="article-end">
          <a href="/rss.xml">
            <Ui text="Subscribe to new articles" /> <Icon name="rss" size={16} />
          </a>
        </div>
      </div>
      {rendered.toc.length > 0 && (
        <aside class="article-toc">
          <div class="toc-inner">
            <h2>
              <Ui text="Table of contents" />
            </h2>
            <span class="eyebrow">
              <Ui text="ON THIS PAGE" />
            </span>
            {rendered.toc.length ? (
              <nav {...uiLabel('Article table of contents')}>
                {rendered.toc.map((item) => (
                  <a
                    data-article-toc-link
                    class:list={{ 'toc-sub': item.depth > 2 }}
                    href={`#${item.id}`}
                  >
                    {item.text}
                  </a>
                ))}
              </nav>
            ) : (
              <p class="sidebar-empty">
                <Ui text="A short read without section headings." />
              </p>
            )}
            <a class="toc-top" href="#main-content">
              <Ui text="Back to top ↑" />
            </a>
          </div>
        </aside>
      )}
    </div>
  </article>
  {related.items.some((item) => item.id !== entry.id) && (
    <section class="related-section page-shell">
      <div class="section-heading">
        <div>
          <span class="eyebrow">
            <Ui text="KEEP EXPLORING" />
          </span>
          <h2>
            <Ui text="You might also like" />
            <span class="heading-dot">.</span>
          </h2>
        </div>
        <a class="text-link" href="/articles">
          <Ui text="All articles" /> <Icon size={17} />
        </a>
      </div>
      <div class="related-grid">
        {related.items
          .filter((item) => item.id !== entry.id)
          .slice(0, 3)
          .map((item, index) => (
            <EntryCard entry={item} variant="card" index={index} />
          ))}
      </div>
    </section>
  )}
  <script>
    import { initializeArticleReading } from '../../scripts/article-reading';
    initializeArticleReading();
  </script>
</PublicLayout>
