---
import Ui from '../../components/public/UiText.astro';
import PublicLayout from '../../layouts/PublicLayout.astro';
import EntryCard from '../../components/public/EntryCard.astro';
import Icon from '../../components/public/Icon.astro';
import { uiLabel } from '../../lib/ui-language';
import { getSettings, getPublished, listPublished } from '../../lib/content';
import { renderMarkdown } from '../../lib/markdown';
import '../../styles/article-detail.css';

const [settings, entry] = await Promise.all([
  getSettings(),
  getPublished('article', Astro.params.slug || ''),
]);
if (!entry) return Astro.rewrite('/404');
const rendered = await renderMarkdown(entry.body);
const related = await listPublished({
  kind: 'article',
  category: entry.category || undefined,
  pageSize: 4,
});
const relatedItems = related.items.filter((item) => item.id !== entry.id).slice(0, 3);
// Prefer the current category; a small collection can still offer other published reading.
if (relatedItems.length < 3) {
  const recent = await listPublished({ kind: 'article', pageSize: 6 });
  const seen = new Set([entry.id, ...relatedItems.map((item) => item.id)]);
  for (const candidate of recent.items) {
    if (seen.has(candidate.id)) continue;
    relatedItems.push(candidate);
    seen.add(candidate.id);
    if (relatedItems.length === 3) break;
  }
}
const date = new Date(entry.publishedAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<PublicLayout
  settings={settings}
  title={entry.seoTitle || entry.title}
  description={entry.seoDescription || entry.excerpt}
  image={entry.cover || undefined}
  article
>
  <article
    class="page-shell article-page article-detail"
    data-article-reader
    aria-labelledby="article-title"
  >
    <a class="back-link" href="/articles">
      <Icon name="back" size={17} /> <Ui text="Back to articles" />
    </a>
    <div class="article-grid">
      <div class="article-reading-column">
        <header class="article-heading">
          <div class="entry-meta">
            <a
              class="category-label"
              href={`/articles?category=${encodeURIComponent(entry.category)}`}
              data-original-content
              translate="no"
            >
              {entry.category || 'Notes'}
            </a>
            <span class="meta-dot" aria-hidden="true">·</span>
            <time datetime={entry.publishedAt}>{date}</time>
            <span class="meta-dot" aria-hidden="true">·</span>
            <span>
              <Ui text="{count} min read" values={{ count: rendered.readingMinutes }} />
            </span>
          </div>
          <h1 id="article-title" data-original-content translate="no">
            {entry.title}
          </h1>
          {entry.excerpt && (
            <p class="article-lead" data-original-content translate="no">
              {entry.excerpt}
            </p>
          )}
          <div class="article-byline">
            <img src={settings.avatar || '/favicon.svg'} alt="" width="44" height="44" />
            <a class="article-author" href="/about" data-original-content translate="no">
              {settings.authorName || settings.siteName}
            </a>
            {entry.tags.length > 0 && (
              <>
                <span class="byline-line" aria-hidden="true"></span>
                <div class="entry-tags" data-original-content translate="no">
                  {entry.tags.map((tag) => (
                    <a href={`/articles?tag=${encodeURIComponent(tag)}`}>#{tag}</a>
                  ))}
                </div>
              </>
            )}
          </div>
        </header>
        {entry.cover && (
          <figure class="article-cover">
            <img
              src={entry.cover}
              alt={entry.coverAlt || entry.title}
              width="1280"
              height="720"
              fetchpriority="high"
            />
          </figure>
        )}
        {rendered.toc.length > 0 && (
          <details class="mobile-toc">
            <summary>
              <Ui text="Table of contents" />
            </summary>
            <nav class="article-outline" {...uiLabel('Mobile article table of contents')}>
              {rendered.toc.map((item) => (
                <a
                  class:list={{ 'toc-sub': item.depth > 2 }}
                  href={`#${encodeURIComponent(item.id)}`}
                  data-toc-target={item.id}
                  data-original-content
                  translate="no"
                >
                  {item.text}
                </a>
              ))}
            </nav>
          </details>
        )}
        <div class="article-body">
          <div
            class="prose article-prose"
            data-original-content
            translate="no"
            set:html={rendered.html}
          />
          <div class="article-end">
            <a href="/rss.xml">
              <Ui text="Subscribe to new articles" /> <Icon name="rss" size={16} />
            </a>
          </div>
        </div>
      </div>
      <aside class="article-toc article-rail">
        <div class="toc-inner article-rail-card">
          <h2>
            <Ui text="Table of contents" />
          </h2>
          {rendered.toc.length ? (
            <nav class="article-outline" {...uiLabel('Article table of contents')}>
              {rendered.toc.map((item) => (
                <a
                  class:list={{ 'toc-sub': item.depth > 2 }}
                  href={`#${encodeURIComponent(item.id)}`}
                  data-toc-target={item.id}
                  data-original-content
                  translate="no"
                >
                  {item.text}
                </a>
              ))}
            </nav>
          ) : (
            <p class="sidebar-empty">
              <Ui text="A short read without section headings." />
            </p>
          )}
          {relatedItems.length > 0 && (
            <section class="article-rail-section" aria-labelledby="article-related-heading">
              <h2 id="article-related-heading">
                <Icon name="file" size={18} /> <Ui text="You might also like" />
              </h2>
              <ul class="article-rail-related" data-original-content translate="no">
                {relatedItems.map((item) => (
                  <li>
                    <a href={`/articles/${encodeURIComponent(item.slug)}`}>{item.title}</a>
                  </li>
                ))}
              </ul>
            </section>
          )}
          {entry.tags.length > 0 && (
            <section class="article-rail-section" aria-labelledby="article-tags-heading">
              <h2 id="article-tags-heading">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m20 13-7 7a2 2 0 0 1-3 0L2 12V2h10l8 8a2 2 0 0 1 0 3Z" />
                  <circle cx="7" cy="7" r="1" />
                </svg>
                <Ui text="Tags" />
              </h2>
              <div class="article-rail-tags" data-original-content translate="no">
                {entry.tags.map((tag) => (
                  <a href={`/articles?tag=${encodeURIComponent(tag)}`}>{tag}</a>
                ))}
              </div>
            </section>
          )}
          {settings.tagline && (
            <div class="article-rail-section">
              <figure class="article-rail-note" data-original-content translate="no">
                <p>{settings.tagline}</p>
                <figcaption>— {settings.siteName}.</figcaption>
              </figure>
            </div>
          )}
          <a class="toc-top" href="#main-content">
            <Ui text="Back to top ↑" />
          </a>
        </div>
      </aside>
    </div>
  </article>
  {relatedItems.length > 0 && (
    <section class="related-section article-related page-shell">
      <div class="section-heading">
        <div>
          <span class="eyebrow">
            <Ui text="KEEP EXPLORING" />
          </span>
          <h2>
            <Ui text="You might also like" />
            <span class="heading-dot">.</span>
          </h2>
        </div>
        <a class="text-link" href="/articles">
          <Ui text="All articles" /> <Icon size={17} />
        </a>
      </div>
      <div class="related-grid">
        {relatedItems.map((item, index) => (
          <EntryCard entry={item} variant="card" index={index} />
        ))}
      </div>
    </section>
  )}
</PublicLayout>

<script>
  // Native fragment links are the baseline; scroll tracking only enhances them.
  const article = document.querySelector<HTMLElement>('[data-article-reader]');
  if (article) {
    const links = [...article.querySelectorAll<HTMLAnchorElement>('a[data-toc-target]')];
    const headings = [...new Set(links.map((link) => link.dataset.tocTarget))].flatMap((id) => {
      const heading = id ? document.getElementById(id) : null;
      return heading && article.contains(heading) ? [heading] : [];
    });
    if (headings.length) {
      let activeId = '';
      let scheduled = false;
      const update = () => {
        scheduled = false;
        const headerHeight =
          document.querySelector('.public-header')?.getBoundingClientRect().height || 0;
        const offset = matchMedia('(min-width: 1024px)').matches ? 104 : headerHeight + 64;
        let current = headings[0];
        for (const heading of headings) {
          if (heading.getBoundingClientRect().top > offset) break;
          current = heading;
        }
        // Short final sections may never reach the top reading line before the page ends.
        if (
          window.scrollY > 0 &&
          window.scrollY + innerHeight >= document.documentElement.scrollHeight - 2
        ) current = headings[headings.length - 1];
        if (current.id === activeId) return;
        activeId = current.id;
        for (const link of links) {
          if (link.dataset.tocTarget === activeId) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        }
        // Reveal a long outline's active entry without scrolling the article itself.
        const activeLink = links.find(
          (link) => link.dataset.tocTarget === activeId && link.closest('.article-rail'),
        );
        const card = activeLink?.closest<HTMLElement>('.article-rail-card');
        if (activeLink && card && card.clientHeight) {
          const linkBox = activeLink.getBoundingClientRect();
          const cardBox = card.getBoundingClientRect();
          if (linkBox.top < cardBox.top + 24) card.scrollTop -= cardBox.top + 24 - linkBox.top;
          else if (linkBox.bottom > cardBox.bottom - 24)
            card.scrollTop += linkBox.bottom - cardBox.bottom + 24;
        }
      };
      const schedule = () => {
        if (scheduled) return;
        scheduled = true;
        requestAnimationFrame(update);
      };
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule, { passive: true });
      window.addEventListener('hashchange', schedule);
      window.addEventListener('pageshow', schedule);
      window.addEventListener('load', schedule);
      document.addEventListener('kaiyo:ui-language', schedule);
      const column = article.querySelector('.article-reading-column');
      if (typeof ResizeObserver !== 'undefined' && column) new ResizeObserver(schedule).observe(column);
      document.fonts.ready.then(schedule);
      article.addEventListener('click', (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const link = event.target instanceof Element
          ? event.target.closest<HTMLAnchorElement>('a[data-toc-target]')
          : null;
        const heading = link?.dataset.tocTarget ? document.getElementById(link.dataset.tocTarget) : null;
        if (!heading) return;
        heading.setAttribute('tabindex', '-1');
        heading.focus({ preventScroll: true });
      });
      schedule();
    }
  }
</script>
