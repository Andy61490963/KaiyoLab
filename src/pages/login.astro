---
import AdminLayout from '../layouts/AdminLayout.astro';
import AuthForm from '../components/admin/AuthForm';
import { db, systemState } from '../lib/db';
import { getAuth } from '../lib/auth';
export const prerender = false;
const [state] = await db().select().from(systemState);
if (!state?.setupComplete) return Astro.redirect('/setup');
const session = await getAuth().api.getSession({ headers: Astro.request.headers });
if (session?.user.id === state.ownerId) return Astro.redirect('/admin');
---

<AdminLayout title="Sign in">
  <AuthForm mode="login" client:only="react">
    <div slot="fallback" class="admin-initial-loading" role="status" aria-busy="true">
      正在開啟登入頁…
    </div>
  </AuthForm>
  <noscript>請啟用 JavaScript 以登入後台</noscript>
</AdminLayout>
