---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminApp from '../../components/admin/AdminApp';
export const prerender = false;
---

<AdminLayout>
  <AdminApp path={Astro.url.pathname} client:only="react">
    <p slot="fallback" class="admin-initial-loading">
      Loading your workspace…
    </p>
  </AdminApp>
  <noscript>Enable JavaScript to use the admin workspace.</noscript>
</AdminLayout>
