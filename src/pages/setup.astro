---
import AdminLayout from '../layouts/AdminLayout.astro';
import AuthForm from '../components/admin/AuthForm';
import { db, systemState } from '../lib/db';
export const prerender = false;
const [state] = await db().select().from(systemState);
if (state?.setupComplete) return Astro.redirect('/login');
---

<AdminLayout title="First-time setup">
  <AuthForm mode="setup" client:only="react">
    <div slot="fallback" class="admin-initial-loading" role="status" aria-busy="true">
      正在開啟首次設定…
    </div>
  </AuthForm>
  <noscript>請啟用 JavaScript 以設定網站</noscript>
</AdminLayout>
