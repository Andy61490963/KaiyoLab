---
import AdminLayout from '../layouts/AdminLayout.astro';
import AuthForm from '../components/admin/AuthForm';
import { db, systemState } from '../lib/db';
export const prerender = false;
const [state] = await db().select().from(systemState);
if (state?.setupComplete) return Astro.redirect('/login');
---
<AdminLayout title="First-time setup">
  <AuthForm mode="setup" client:only="react"><div slot="fallback" class="admin-initial-loading" role="status" aria-busy="true">Opening first-time setup…</div></AuthForm>
  <noscript>Enable JavaScript to set up your site.</noscript>
</AdminLayout>
