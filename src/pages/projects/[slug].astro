---
import Ui from '../../components/public/UiText.astro';
import PublicLayout from '../../layouts/PublicLayout.astro';
import Icon from '../../components/public/Icon.astro';
import { uiLabel } from '../../lib/ui-language';
import { getSettings, getPublished, publishedRedirect } from '../../lib/content';
import { mediaPresentation } from '../../lib/media-presentation';
import { renderMarkdown } from '../../lib/markdown';
const [settings, entry] = await Promise.all([
  getSettings(),
  getPublished('project', Astro.params.slug || ''),
]);
if (!entry) {
  const redirect = await publishedRedirect('project', Astro.params.slug || '');
  if (redirect) return Astro.redirect(redirect, 301);
  return Astro.rewrite('/404');
}
const rendered = await renderMarkdown(entry.body);
---

<PublicLayout
  settings={settings}
  title={entry.seoTitle || entry.title}
  description={entry.seoDescription || entry.excerpt}
  image={entry.cover || undefined}
>
  <article class="page-shell project-detail">
    <a class="back-link" href="/projects">
      <Icon name="back" size={17} /> <Ui text="Back to projects" />
    </a>
    <header class="project-detail-heading">
      <div>
        <span class="eyebrow">
          <Ui text="A PROJECT BY" /> {settings.authorName || settings.siteName}
        </span>
        <h1 data-original-content translate="no">
          {entry.title}
        </h1>
        <p>{entry.excerpt}</p>
        <div class="entry-tags">
          {entry.tags.map((tag) => (
            <span class="technology-tag">{tag}</span>
          ))}
        </div>
      </div>
      <div class="project-external-links">
        {entry.demoUrl && (
          <a
            class="button button-primary"
            href={entry.demoUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Ui text="Open demo" /> <Icon name="diagonal" size={18} />
          </a>
        )}
        {entry.repoUrl && (
          <a
            class="button button-secondary"
            href={entry.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="code" size={18} /> <Ui text="Source code" />{' '}
            <Icon name="diagonal" size={16} />
          </a>
        )}
      </div>
    </header>
    {entry.cover && (
      <figure class="project-cover">
        <img
          {...mediaPresentation(entry.cover, entry.coverPosition)}
          sizes="(max-width: 768px) 100vw, 960px"
          alt={entry.coverAlt || entry.title}
          width="1280"
          height="720"
        />
      </figure>
    )}
    <div class="reading-layout">
      <div class="article-body">
        <div class="prose" data-original-content translate="no" set:html={rendered.html} />
      </div>
      <aside class="article-toc">
        <div class="toc-inner">
          <h2>
            <Ui text="Project details" />
          </h2>
          <dl class="project-facts">
            <dt>
              <Ui text="Published" />
            </dt>
            <dd>{new Date(entry.publishedAt).toLocaleDateString('en-US')}</dd>
            <dt>
              <Ui text="Last updated" />
            </dt>
            <dd>{new Date(entry.updatedAt).toLocaleDateString('zh-TW')}</dd>
            {entry.category && (
              <>
                <dt>
                  <Ui text="Category" />
                </dt>
                <dd>{entry.category}</dd>
              </>
            )}
          </dl>
          {rendered.toc.length > 0 && (
            <nav {...uiLabel('Project table of contents')}>
              {rendered.toc.map((item) => (
                <a class:list={{ 'toc-sub': item.depth > 2 }} href={`#${item.id}`}>
                  {item.text}
                </a>
              ))}
            </nav>
          )}
        </div>
      </aside>
    </div>
  </article>
</PublicLayout>
