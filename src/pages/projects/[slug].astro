---
import UiText from '../../components/public/UiText.astro';
import PublicLayout from '../../layouts/PublicLayout.astro';
import Icon from '../../components/public/Icon.astro';
import { getSettings, getPublished } from '../../lib/content';
import { renderMarkdown } from '../../lib/markdown';
const [settings, entry] = await Promise.all([
  getSettings(),
  getPublished('project', Astro.params.slug || ''),
]);
if (!entry) return Astro.rewrite('/404');
const rendered = await renderMarkdown(entry.body);
---

<PublicLayout
  settings={settings}
  title={entry.seoTitle || entry.title}
  description={entry.seoDescription || entry.excerpt}
  image={entry.cover || undefined}
>
  <article class="page-shell project-detail">
    <a class="back-link" href="/projects">
      <Icon name="back" size={17} /> <UiText en="Back to projects" zh="返回專案列表" />
    </a>
    <header class="project-detail-heading">
      <div>
        <span class="eyebrow">
          <UiText en="A PROJECT BY" zh="專案作者" /> {settings.authorName || settings.siteName}
        </span>
        <h1>{entry.title}</h1>
        <p>{entry.excerpt}</p>
        <div class="entry-tags">
          {entry.tags.map((tag) => (
            <span class="technology-tag">{tag}</span>
          ))}
        </div>
      </div>
      <div class="project-external-links">
        {entry.demoUrl && (
          <a
            class="button button-primary"
            href={entry.demoUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <UiText en="Open demo" zh="開啟展示" /> <Icon name="diagonal" size={18} />
          </a>
        )}
        {entry.repoUrl && (
          <a
            class="button button-secondary"
            href={entry.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="code" size={18} /> <UiText en="Source code" zh="原始碼" />{' '}
            <Icon name="diagonal" size={16} />
          </a>
        )}
      </div>
    </header>
    {entry.cover && (
      <figure class="project-cover">
        <img src={entry.cover} alt={entry.coverAlt || entry.title} width="1280" height="720" />
      </figure>
    )}
    <div class="reading-layout">
      <div class="article-body">
        <div class="prose" data-authored-content translate="no" set:html={rendered.html} />
      </div>
      <aside class="article-toc">
        <div class="toc-inner">
          <h2>
            <UiText en="Project details" zh="專案資訊" />
          </h2>
          <dl class="project-facts">
            <dt>
              <UiText en="Published" zh="發布日期" />
            </dt>
            <dd>{new Date(entry.publishedAt).toLocaleDateString('en-US')}</dd>
            <dt>
              <UiText en="Last updated" zh="最後更新" />
            </dt>
            <dd>{new Date(entry.updatedAt).toLocaleDateString('zh-TW')}</dd>
            {entry.category && (
              <>
                <dt>
                  <UiText en="Category" zh="分類" />
                </dt>
                <dd>{entry.category}</dd>
              </>
            )}
          </dl>
          {rendered.toc.length > 0 && (
            <nav aria-label="Project table of contents" data-ui-label="projectToc">
              {rendered.toc.map((item) => (
                <a class:list={{ 'toc-sub': item.depth > 2 }} href={`#${item.id}`}>
                  {item.text}
                </a>
              ))}
            </nav>
          )}
        </div>
      </aside>
    </div>
  </article>
</PublicLayout>
