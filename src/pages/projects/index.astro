---
import Ui from '../../components/public/UiText.astro';
import PublicLayout from '../../layouts/PublicLayout.astro';
import ProjectCard from '../../components/public/ProjectCard.astro';
import Pagination from '../../components/public/Pagination.astro';
import CollectionControls from '../../components/public/CollectionControls.astro';
import Icon from '../../components/public/Icon.astro';
import { uiLabel } from '../../lib/ui-language';
import { getSettings, listPublished } from '../../lib/content';
import { publicListingHref, projectList, readPublicListing } from '../../lib/listing';
import '../../styles/public-collection.css';
const q = (Astro.url.searchParams.get('q') || '').trim().slice(0, 200);
const options = readPublicListing(Astro.url.searchParams, projectList);
const [settings, result] = await Promise.all([
  getSettings(),
  listPublished({ kind: 'project', q, ...options }),
]);
---

<PublicLayout
  settings={settings}
  title="Projects"
  titleKey="Projects"
  description="Personal projects and open-source work."
>
  <div class="page-shell projects-page">
    <header class="collection-header">
      <h1 class="page-title">
        <Icon name="code" size={36} />
        <Ui text="Projects" />
      </h1>
    </header>
    <section data-public-collection data-collection-id="projects">
      {(result.total > 0 || q) && (
        <CollectionControls
          config={projectList}
          sort={options.sort}
          q={q}
          searchId="project-search"
          searchLabel="Search projects"
        />
      )}
      <div data-collection-results data-total={result.total} data-page={result.page}>
        {((result.total > 0 && result.pages === 1) || q) && (
          <div class="collection-results">
            {result.total > 0 && result.pages === 1 && (
              <span>
                <Ui
                  text={result.total === 1 ? '{count} project' : '{count} projects'}
                  values={{ count: result.total }}
                />
              </span>
            )}
            {q && (
              <a data-collection-link href={publicListingHref(Astro.url, { q: null, page: null })}>
                <Ui text="Clear filters" />
                <Icon name="close" size={14} />
              </a>
            )}
          </div>
        )}
        <section class="project-grid" {...uiLabel('Project list')}>
          {result.items.length ? (
            result.items.map((entry) => <ProjectCard entry={entry} />)
          ) : (
            <p class="collection-empty">
              <Ui text={q ? 'No matching projects' : 'No published projects yet'} />
            </p>
          )}
        </section>
        <Pagination
          page={result.page}
          pages={result.pages}
          total={result.total}
          pageSize={result.pageSize}
        />
      </div>
    </section>
  </div>
</PublicLayout>
<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .project-grid .collection-empty {
    grid-column: 1 / -1;
  }
  @media (max-width: 1199px) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 620px) {
    .project-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
