---
import PublicLayout from '../../layouts/PublicLayout.astro';
import ProjectCard from '../../components/public/ProjectCard.astro';
import EmptyState from '../../components/public/EmptyState.astro';
import Pagination from '../../components/public/Pagination.astro';
import Icon from '../../components/public/Icon.astro';
import { getSettings, listPublished } from '../../lib/content';
const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);
const [settings, result] = await Promise.all([
  getSettings(),
  listPublished({ kind: 'project', page, pageSize: 12 }),
]);
---

<PublicLayout settings={settings} title="作品" description="個人作品與開源專案列表">
  <div class="page-shell projects-page">
    <header class="collection-header">
      <h1 class="page-title">
        <Icon name="code" size={36} />
        作品
      </h1>
      <p>做過的專案與開源作品，點開可查看介紹及相關連結</p>
    </header>
    <section class="project-grid" aria-label="作品列表">
      {result.items.length ? (
        result.items.map((entry) => <ProjectCard entry={entry} />)
      ) : (
        <EmptyState
          title="目前沒有已發布的作品"
          description="發布作品後，介紹與連結會顯示在這裡"
          icon="code"
        />
      )}
    </section>
    <Pagination page={result.page} pages={result.pages} />
  </div>
</PublicLayout>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .project-grid :global(.empty-state) {
    grid-column: 1 / -1;
  }

  @media (max-width: 1199px) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .project-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
