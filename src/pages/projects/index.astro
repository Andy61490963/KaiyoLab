---
import Ui from '../../components/public/UiText.astro';
import PublicLayout from '../../layouts/PublicLayout.astro';
import ProjectCard from '../../components/public/ProjectCard.astro';
import EmptyState from '../../components/public/EmptyState.astro';
import Pagination from '../../components/public/Pagination.astro';
import Icon from '../../components/public/Icon.astro';
import { uiLabel } from '../../lib/ui-language';
import { getSettings, listPublished } from '../../lib/content';
const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);
const [settings, result] = await Promise.all([
  getSettings(),
  listPublished({ kind: 'project', page, pageSize: 12 }),
]);
---

<PublicLayout
  settings={settings}
  title="Projects"
  titleKey="Projects"
  description="Personal projects and open-source work."
>
  <div class="page-shell projects-page">
    <header class="collection-header">
      <h1 class="page-title">
        <Icon name="code" size={36} />
        <Ui text="Projects" />
      </h1>
      <p>
        <Ui text="Selected projects and open-source work, with details and related links." />
      </p>
    </header>
    <section class="project-grid" {...uiLabel('Project list')}>
      {result.items.length ? (
        result.items.map((entry) => <ProjectCard entry={entry} />)
      ) : (
        <EmptyState
          title="No published projects yet"
          description="Published projects and links will appear here."
          icon="code"
        />
      )}
    </section>
    <Pagination page={result.page} pages={result.pages} />
  </div>
</PublicLayout>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .project-grid :global(.empty-state) {
    grid-column: 1 / -1;
  }

  @media (max-width: 1199px) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .project-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
