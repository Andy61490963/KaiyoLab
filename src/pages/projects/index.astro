---
import Ui from '../../components/public/UiText.astro';
import PublicLayout from '../../layouts/PublicLayout.astro';
import ProjectCard from '../../components/public/ProjectCard.astro';
import EmptyState from '../../components/public/EmptyState.astro';
import Pagination from '../../components/public/Pagination.astro';
import CollectionControls from '../../components/public/CollectionControls.astro';
import Icon from '../../components/public/Icon.astro';
import { uiLabel, uiPlaceholder } from '../../lib/ui-language';
import { getSettings, listPublished } from '../../lib/content';
import { listingHref, projectList, readListing } from '../../lib/listing';
const q = (Astro.url.searchParams.get('q') || '').trim().slice(0, 200);
const options = readListing(Astro.url.searchParams, projectList);
const [settings, result] = await Promise.all([
  getSettings(),
  listPublished({ kind: 'project', q, ...options }),
]);
---

<PublicLayout
  settings={settings}
  title="Projects"
  titleKey="Projects"
  description="Personal projects and open-source work."
>
  <div class="page-shell projects-page">
    <header class="collection-header">
      <h1 class="page-title">
        <Icon name="code" size={36} />
        <Ui text="Projects" />
      </h1>
      <p>
        <Ui text="Selected projects and open-source work, with details and related links." />
      </p>
    </header>
    <form class="search-form" method="get" action="/projects" role="search">
      <label class="sr-only" for="project-search"><Ui text="Search projects" /></label>
      <Icon name="search" size={19} />
      <input id="project-search" type="search" name="q" value={q} maxlength="200"
        {...uiPlaceholder('Search titles or content…')} autocomplete="off" />
      <input type="hidden" name="sort" value={options.sort} />
      <input type="hidden" name="pageSize" value={options.pageSize} />
      <button type="submit"><Ui text="Search" /> <Icon name="arrow" size={16} /></button>
    </form>
    <CollectionControls config={projectList} sort={options.sort} pageSize={result.pageSize} />
    <div class="collection-results">
      <span><Ui text={result.total === 1 ? '{count} project' : '{count} projects'} values={{ count: result.total }} />
        {q && <Ui text=" matching “{query}”" values={{ query: q }} />}
      </span>
      {q && <a href={listingHref(Astro.url, { q: null, page: null })}><Ui text="Clear filters" /> <Icon name="close" size={14} /></a>}
    </div>
    <section class="project-grid" {...uiLabel('Project list')}>
      {result.items.length ? (
        result.items.map((entry) => <ProjectCard entry={entry} />)
      ) : (
        <EmptyState
          title={q ? 'No matching projects' : 'No published projects yet'}
          description={q ? 'Try another keyword or clear the search.' : 'Published projects and links will appear here.'}
          icon="code"
        />
      )}
    </section>
    <Pagination page={result.page} pages={result.pages} total={result.total} pageSize={result.pageSize} />
  </div>
</PublicLayout>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .project-grid :global(.empty-state) {
    grid-column: 1 / -1;
  }

  @media (max-width: 1199px) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .project-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
