# 直接 docker compose up -d 無須建立此檔。
# 公開部署時複製為 .env，設定自己的 HTTPS 網域。
SITE_URL=http://localhost:4321
# DOMAIN=example.com
# APP_PORT=4321

# 以下僅供本機 npm 開發；Docker 會自動產生及保存密鑰。
# DATABASE_URL=postgresql://kaiyo:自行設定的密碼@localhost:5432/kaiyolab
# BETTER_AUTH_SECRET=請使用至少32位元組的隨機密鑰
# SETUP_TOKEN=請使用隨機初始化碼
# UPLOAD_DIR=./data/uploads
# OPERATIONS_DIR=./backups
